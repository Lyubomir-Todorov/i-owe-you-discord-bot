{
  "name": "i-owe-you-discord-bot",
  "version": "2.0.0",
  "description": "A discord bot that keeps track of expenses in Google Sheets",
  "main": "src/main.ts",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "cron": "^3.1.7",
    "date-fns": "^3.6.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "google-auth-library": "^8.9.0",
    "google-spreadsheet": "^4.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.27",
    "babel-jest": "^29.7.0",
    "eslint": "9.26.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.1",
    "tslib": "^2.6.2",
    "tsup": "8.3.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
